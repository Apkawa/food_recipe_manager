{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "web#dev": {
      "dependsOn": ["@repo/food-recipe-core#build"]
    },
    "web#build": {
      "dependsOn": ["@repo/food-recipe-core#build"]
    },
    "web-react#dev": {
      "dependsOn": ["@repo/food-recipe-core#build"]
    },
    "web-react#build": {
      "dependsOn": ["@repo/food-recipe-core#build"]
    },
    "format:check": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
