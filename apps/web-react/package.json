{
  "name": "web-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type && pnpm run build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format --write src/ dist/",
    "format:check": "biome check src/ --write",
    "lint": "biome check src/",
    "type": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@repo/food-recipe-core": "workspace:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vitest": "catalog:"
  }
}
