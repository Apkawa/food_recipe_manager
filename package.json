{
  "name": "food_recipe_manager",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:smoke": "PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright playwright test tests/smoke",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright playwright test tests/e2e",
    "format": "biome format apps packages --diagnostic-level=error",
    "format:fix": "pnpm format --fix",
    "format:check": "pnpm -r format:check",
    "check": "pnpm run test && pnpm run lint",
    "pre-commit": "pnpm run format && pnpm run check && pnpm run build",
    "commitlint": "commitlint --config '.config/.commitlintrc.json'",
    "commit": "pnpm run pre-commit && ts-node node_modules/.bin/cz",
    "prepare": "husky install",
    "release": "standard-version",
    "release:pre": "pnpm run release -- --prerelease --skip.tag",
    "release:patch": "pnpm run release -- --release-as patch",
    "release:minor": "pnpm run release -- --release-as minor"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@playwright/test": "^1.64.1",
    "@repo/typescript-config": "workspace:",
    "commitizen": "catalog:",
    "cz-customizable": "catalog:",
    "husky": "catalog:",
    "standard-version": "catalog:",
    "ts-node": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.config/commitzen.ts"
    }
  }
}
