{
  "extends": "@tsconfig/node20/tsconfig.json",
  "exclude": ["tests/**", "vitest.config.ts"],
  "compilerOptions": {
    "module": "Node16",
    "target": "es2022",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["./src/food_recipe/*"],
      "@tests/*": ["./tests/*"]
    },
    "types": ["node", "vitest/globals"],
    "verbatimModuleSyntax": false
  }
}
